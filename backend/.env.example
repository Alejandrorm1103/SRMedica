# ===========================================
# CONFIGURACIÓN DE ENTORNO - SR MEDICA API
# ===========================================

# -------------------------------------------
# ENTORNO
# -------------------------------------------
# Valores: development | production | test
NODE_ENV=development

# Puerto en el que correrá el servidor
PORT=3000

# -------------------------------------------
# BASE DE DATOS
# -------------------------------------------
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# Ejemplo: postgresql://postgres:password@localhost:5432/srmedica
DATABASE_URL=postgresql://postgres:password@localhost:5432/srmedica

# -------------------------------------------
# AUTENTICACIÓN
# -------------------------------------------
# Secreto para firmar tokens JWT
# IMPORTANTE: Debe tener al menos 32 caracteres para seguridad
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-required-change-this

# -------------------------------------------
# SERVICIO DE EMAIL
# -------------------------------------------
# El sistema usa diferentes proveedores según el entorno:
# - DESARROLLO (NODE_ENV=development): Ethereal Email (100% GRATIS, auto-configurado)
#   * No requiere configuración
#   * Funciona con cualquier email (incluso yopmail)
#   * Los emails se capturan en https://ethereal.email/messages
#   * Perfecto para pruebas locales
#
# - TEST/PRODUCCIÓN: Resend (requiere API key)
#   * Obtén tu API key en https://resend.com
#   * Email remitente debe estar verificado
#
# NOTA: En desarrollo, Ethereal se configura automáticamente.
#       Solo necesitas configurar Resend para test/producción.

# API Key de Resend (solo para test/producción)
RESEND_API_KEY=re_123456789_your_resend_api_key_here

# Email remitente para Resend (solo para test/producción)
# Para desarrollo con Resend puedes usar: onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@tudominio.com

# -------------------------------------------
# FRONTEND
# -------------------------------------------
# URL del frontend para links en emails
# Desarrollo: http://localhost:5173
# Producción: https://tudominio.com
FRONTEND_URL=http://localhost:5173

# -------------------------------------------
# OPCIONAL: GUARDS Y DEBUGGING
# -------------------------------------------
# Deshabilitar guards de autenticación (solo desarrollo)
# SKIP_GUARDS=true

# ID de usuario para debugging (cuando SKIP_GUARDS=true)
# DEBUG_USER_ID=1

# Roles para debugging (cuando SKIP_GUARDS=true)
# DEBUG_USER_ROLES=paciente,medico
